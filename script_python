"""Análise exploratória simples das movimentações mensais por PIX e TED.

Entrada principal: dados/Meios de Pagamentos Mensais.csv
Saídas: base tratada, tabelas-resumo e gráficos usados no relatório.
"""

from pathlib import Path
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

ROOT = Path(__file__).resolve().parents[1]
DATA = ROOT / "dados"
TABLES = ROOT / "resultados" / "tabelas"
CHARTS = ROOT / "resultados" / "graficos"

TABLES.mkdir(parents=True, exist_ok=True)
CHARTS.mkdir(parents=True, exist_ok=True)

INPUT = DATA / "Meios de Pagamentos Mensais.csv"
if not INPUT.exists():
    raise FileNotFoundError(f"Arquivo não encontrado: {INPUT}")

df = pd.read_csv(INPUT, dtype=str)


def para_numero(serie: pd.Series) -> pd.Series:
    texto = serie.astype(str).str.strip()
    # A vírgula representa o separador decimal no arquivo do BCB
    texto = texto.str.replace(",", ".", regex=False)
    return pd.to_numeric(texto, errors="coerce")


numeric_cols = [c for c in df.columns if c != "AnoMes"]
for col in numeric_cols:
    df[col] = para_numero(df[col])

df["AnoMes"] = pd.to_numeric(df["AnoMes"], errors="coerce").astype("Int64")
df["Data"] = pd.to_datetime(df["AnoMes"].astype(str), format="%Y%m", errors="coerce")

df = df.dropna(subset=["Data"]).sort_values("Data").drop_duplicates("Data").reset_index(drop=True)

selected = ["quantidadePix", "valorPix", "quantidadeTED", "valorTED"]
if df[selected].isna().any().any():
    raise ValueError("Foram encontrados valores ausentes nas colunas principais após a conversão.")

df["Ano"] = df["Data"].dt.year
df["Mes"] = df["Data"].dt.month

# Quantidades estão em milhares e valores em R$ milhões
df["ticketPix_R"] = np.where(df["quantidadePix"] > 0, df["valorPix"] / df["quantidadePix"] * 1000, np.nan)
df["ticketTED_R"] = np.where(df["quantidadeTED"] > 0, df["valorTED"] / df["quantidadeTED"] * 1000, np.nan)

total_qtd = df["quantidadePix"] + df["quantidadeTED"]
df["sharePix_qtd_pct"] = np.where(total_qtd > 0, df["quantidadePix"] / total_qtd * 100, np.nan)
df["variacao_mensal_qtd_pix_pct"] = df["quantidadePix"].where(df["quantidadePix"] > 0).pct_change() * 100
df["variacao_mensal_qtd_ted_pct"] = df["quantidadeTED"].pct_change() * 100

common = df[df["quantidadePix"] > 0].copy()

annual = common.groupby("Ano", as_index=False).agg(
    meses=("Data", "count"),
    quantidade_pix=("quantidadePix", "sum"),
    valor_pix=("valorPix", "sum"),
    quantidade_ted=("quantidadeTED", "sum"),
    valor_ted=("valorTED", "sum"),
)
annual["ticket_pix_R"] = annual["valor_pix"] / annual["quantidade_pix"] * 1000
annual["ticket_ted_R"] = annual["valor_ted"] / annual["quantidade_ted"] * 1000
annual["share_pix_qtd_pct"] = annual["quantidade_pix"] / (annual["quantidade_pix"] + annual["quantidade_ted"]) * 100
annual["crescimento_qtd_pix_pct"] = annual["quantidade_pix"].pct_change() * 100
annual["crescimento_qtd_ted_pct"] = annual["quantidade_ted"].pct_change() * 100
annual.to_csv(TABLES / "resumo_anual.csv", index=False)


def resumo_meio(nome, qtd, valor, ticket):
    return {
        "Meio": nome,
        "Quantidade média mensal (milhares)": qtd.mean(),
        "Quantidade mediana mensal (milhares)": qtd.median(),
        "Quantidade mínima mensal (milhares)": qtd.min(),
        "Quantidade máxima mensal (milhares)": qtd.max(),
        "Valor médio mensal (R$ milhões)": valor.mean(),
        "Valor mediano mensal (R$ milhões)": valor.median(),
        "Ticket médio agregado (R$)": valor.sum() / qtd.sum() * 1000,
        "Ticket mínimo mensal (R$)": ticket.min(),
        "Ticket máximo mensal (R$)": ticket.max(),
    }


stats = pd.DataFrame([
    resumo_meio("PIX", common["quantidadePix"], common["valorPix"], common["ticketPix_R"]),
    resumo_meio("TED", common["quantidadeTED"], common["valorTED"], common["ticketTED_R"]),
])
stats.to_csv(TABLES / "estatistica_descritiva.csv", index=False)

first, last = common.iloc[0], common.iloc[-1]
key = pd.DataFrame({
    "Indicador": [
        "Número de meses no período comum",
        "Crescimento da quantidade mensal de PIX entre primeiro e último mês (%)",
        "Variação da quantidade mensal de TED entre primeiro e último mês (%)",
        "Participação do PIX na quantidade PIX+TED no último mês (%)",
        "Ticket PIX no último mês (R$)",
        "Ticket TED no último mês (R$)",
    ],
    "Valor": [
        len(common),
        (last["quantidadePix"] / first["quantidadePix"] - 1) * 100,
        (last["quantidadeTED"] / first["quantidadeTED"] - 1) * 100,
        last["sharePix_qtd_pct"],
        last["ticketPix_R"],
        last["ticketTED_R"],
    ],
})
key.to_csv(TABLES / "indicadores_chave.csv", index=False)

plt.style.use("seaborn-v0_8-whitegrid")
COLORS = {"PIX": "#0B7285", "TED": "#E67700"}


def save_line(y1, y2, ylabel, title, filename, scale1=1, scale2=1):
    fig, ax = plt.subplots(figsize=(9, 4.7))
    ax.plot(common["Data"], y1 / scale1, label="PIX", color=COLORS["PIX"], linewidth=2.2)
    ax.plot(common["Data"], y2 / scale2, label="TED", color=COLORS["TED"], linewidth=2.0)
    ax.set_ylabel(ylabel)
    ax.set_title(title)
    ax.legend()
    fig.tight_layout()
    fig.savefig(CHARTS / filename, dpi=220)
    plt.close(fig)


save_line(
    common["quantidadePix"],
    common["quantidadeTED"],
    "Bilhões de transações",
    "Quantidade mensal de transações",
    "01_quantidade_mensal.png",
    1e6,
    1e6,
)
save_line(
    common["valorPix"],
    common["valorTED"],
    "R$ trilhões",
    "Valor mensal movimentado",
    "02_valor_mensal.png",
    1e6,
    1e6,
)

fig, ax = plt.subplots(figsize=(9, 4.7))
ax.plot(common["Data"], common["ticketPix_R"], label="PIX", color=COLORS["PIX"], linewidth=2.2)
ax.plot(common["Data"], common["ticketTED_R"], label="TED", color=COLORS["TED"], linewidth=2.0)
ax.set_yscale("log")
ax.set_ylabel("R$ por transação (escala logarítmica)")
ax.set_title("Ticket médio mensal")
ax.legend()
fig.tight_layout()
fig.savefig(CHARTS / "03_ticket_medio.png", dpi=220)
plt.close(fig)

fig, ax = plt.subplots(figsize=(9, 4.7))
ax.plot(common["Data"], common["sharePix_qtd_pct"], color="#5F3DC4", linewidth=2.2)
ax.set_ylim(0, 100)
ax.set_ylabel("Participação (%)")
ax.set_title("Participação do PIX na quantidade combinada de PIX e TED")
fig.tight_layout()
fig.savefig(CHARTS / "04_participacao_pix.png", dpi=220)
plt.close(fig)

# Anos completos comparáveis
plot_annual = annual[annual["meses"] == 12].copy()
x = np.arange(len(plot_annual))
fig, ax = plt.subplots(figsize=(9, 4.7))
w = 0.36
ax.bar(x - w / 2, plot_annual["quantidade_pix"] / 1e6, w, label="PIX", color=COLORS["PIX"])
ax.bar(x + w / 2, plot_annual["quantidade_ted"] / 1e6, w, label="TED", color=COLORS["TED"])
ax.set_xticks(x, plot_annual["Ano"].astype(str))
ax.set_ylabel("Bilhões de transações no ano")
ax.set_title("Quantidade anual - anos completos")
ax.legend()
fig.tight_layout()
fig.savefig(CHARTS / "05_quantidade_anual.png", dpi=220)
plt.close(fig)

df.to_csv(DATA / "Meios_de_Pagamentos_Mensais_Tratado_Reproduzido.csv", index=False)
common.to_csv(DATA / "pix_ted_periodo_comum.csv", index=False)

print("Análise concluída.")
print(f"Registros tratados: {len(df)} | Período comum: {len(common)} meses")
print(stats.to_string(index=False))
