  print(f"TED Ticket Médio: R$ {ultimo['TED_Ticket_Medio_R']:.2f}")


def executar_modelagem_preditiva(df):
  """Executa a engenharia de atributos temporais (lags/sazonalidade), divisão

  cronológica treino/teste e avaliação de modelos de regressão.
  """
  df_ml = df[df['Era_Post_PIX'] == 1].copy().reset_index(drop=True)

  # 1. Engenharia de Atributos Temporais (Prevenção de Target Leakage)
  df_ml['valorPix_Lag1'] = df_ml['valorPix'].shift(1)
  df_ml['valorPix_Lag2'] = df_ml['valorPix'].shift(2)
  df_ml['quantidadePix_Lag1'] = df_ml['quantidadePix'].shift(1)
  df_ml['valorTED_Lag1'] = df_ml['valorTED'].shift(1)

  # Sazonalidade cíclica mensal
  df_ml['Mes_Sin'] = np.sin(2 * np.pi * df_ml['Mes'] / 12)
  df_ml['Mes_Cos'] = np.cos(2 * np.pi * df_ml['Mes'] / 12)

  # Remoção dos primeiros meses que contêm NaN decorrentes dos lags
  df_clean = df_ml.dropna().reset_index(drop=True)

  # Definição das variáveis explicativas (X) e alvo (y)
  features = [
      'Indice_Mes',
      'Mes_Sin',
      'Mes_Cos',
      'valorPix_Lag1',
      'valorPix_Lag2',
      'quantidadePix_Lag1',
      'valorTED_Lag1',
  ]
  target = 'valorPix'

  X = df_clean[features]
  y = df_clean[target]

  # 2. Divisão Cronológica para Séries Temporais (80% Treino Antigo, 20% Teste Recente)
  split_idx = int(len(df_clean) * 0.80)
  X_train, X_test = X.iloc[:split_idx], X.iloc[split_idx:]
  y_train, y_test = y.iloc[:split_idx], y.iloc[split_idx:]

  # Padronização de escala
  scaler = StandardScaler()
  X_train_scaled = scaler.fit_transform(X_train)
  X_test_scaled = scaler.transform(X_test)

  # 3. Modelos Preditivos
  modelos = {
      'Regressão Linear (com Lags)': (LinearRegression(), True),
      'Random Forest Regressor': (
          RandomForestRegressor(n_estimators=100, random_state=42),
          False,
      ),
      'Gradient Boosting Regressor': (
          GradientBoostingRegressor(
              n_estimators=100, learning_rate=0.05, random_state=42
          ),
          False,
      ),
  }

  resultados = []

  for nome, (model, precisa_escalar) in modelos.items():
    if precisa_escalar:
      model.fit(X_train_scaled, y_train)
      y_pred = model.predict(X_test_scaled)
    else:
      model.fit(X_train, y_train)
      y_pred = model.predict(X_test)

    mae = mean_absolute_error(y_test, y_pred)
    rmse = np.sqrt(mean_squared_error(y_test, y_pred))
    mape = np.mean(np.abs((y_test - y_pred) / y_test)) * 100
    r2 = r2_score(y_test, y_pred)

    resultados.append({
        'Algoritmo': nome,
        'MAE (R$ Mi)': round(mae, 2),
        'RMSE (R$ Mi)': round(rmse, 2),
        'MAPE (%)': round(mape, 2),
        'R² Score': round(r2, 4),
    })

  return pd.DataFrame(resultados)


if __name__ == '__main__':
  caminho_arquivo = 'Meios de Pagamentos Mensais.csv'

  # Processamento e exportação da base tratada
  df_processado = carregar_e_tratar_dados(caminho_arquivo)
  df_processado.to_csv(
      'Meios_de_Pagamentos_Mensais_Tratado.csv',
      index=False,
      encoding='utf-8-sig',
  )

  # Exibição dos resultados
  gerar_estatisticas_resumo(df_processado)
  df_res = executar_modelagem_preditiva(df_processado)

  print('\n--- RESULTADOS EXPERIMENTAIS DA MODELAGEM PREDITIVA (AJUSTADA) ---')
  print(df_res.to_string(index=False))
