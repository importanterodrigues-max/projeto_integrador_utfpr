import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LinearRegression
from sklearn.ensemble import RandomForestRegressor, GradientBoostingRegressor
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score

def carregar_e_tratar_dados(caminho_csv):
    # 1. Carga do arquivo CSV original do BCB
    df = pd.read_csv(caminho_csv)
    print(f"[INFO] Arquivo carregado: {df.shape[0]} linhas e {df.shape[1]} colunas.")
    
    # 2. Conversão de colunas com vírgula decimal para float
    cols_numericas = [c for c in df.columns if c != 'AnoMes']
    for col in cols_numericas:
        df[col] = df[col].astype(str).str.replace(',', '.').astype(float)
        
    # 3. Ordenação cronológica
    df['AnoMes_str'] = df['AnoMes'].astype(str)
    df['Data'] = pd.to_datetime(df['AnoMes_str'], format='%Y%m')
    df = df.sort_values('Data').reset_index(drop=True)
    df['Ano'] = df['Data'].dt.year
    df['Mes'] = df['Data'].dt.month
    
    # 4. Engenharia de Atributos (Feature Engineering)
    # Ticket Médio por transação (R$)
    df['TED_Ticket_Medio_R'] = np.where(
        df['quantidadeTED'] > 0, 
        (df['valorTED'] * 1000000) / (df['quantidadeTED'] * 1000), 
        0
    )
    df['PIX_Ticket_Medio_R'] = np.where(
        df['quantidadePix'] > 0, 
        (df['valorPix'] * 1000000) / (df['quantidadePix'] * 1000), 
        0
    )
    
    # Participação do PIX no volume de transações (%)
    df['Total_Qtd_Eletronica'] = df['quantidadeTED'] + df['quantidadePix'] + df['quantidadeDOC'] + df['quantidadeBoleto']
    df['PIX_Share_Qtd_Pct'] = np.where(
        df['Total_Qtd_Eletronica'] > 0, 
        (df['quantidadePix'] / df['Total_Qtd_Eletronica']) * 100, 
        0
    )
    
    # Marcador temporal (Índice sequencial e Flag pós-PIX)
    df['Era_Post_PIX'] = (df['Data'] >= '2020-11-01').astype(int)
    df['Indice_Mes'] = np.arange(1, len(df) + 1)
    
    return df

def gerar_estatisticas_resumo(df):
    df_post = df[df['Era_Post_PIX'] == 1]
    
    print("\n--- RESUMO DE INDICADORES MÉDIOS PÓS-LANÇAMENTO DO PIX (NOV/2020 A AGO/2026) ---")
    print(f"PIX - Quantidade Média Mensal: {df_post['quantidadePix'].mean():,.2f} mil transações")
    print(f"PIX - Volume Médio Mensal: R$ {df_post['valorPix'].mean():,.2f} milhões")
    print(f"PIX - Ticket Médio Estimado: R$ {df_post['PIX_Ticket_Medio_R'].mean():,.2f}")
    
    print(f"\nTED - Quantidade Média Mensal: {df_post['quantidadeTED'].mean():,.2f} mil transações")
    print(f"TED - Volume Médio Mensal: R$ {df_post['valorTED'].mean():,.2f} milhões")
    print(f"TED - Ticket Médio Estimado: R$ {df_post['TED_Ticket_Medio_R'].mean():,.2f}")
    
    ultimo = df.iloc[-1]
    print(f"\n--- ÚLTIMA OBSERVAÇÃO DISPONÍVEL ({ultimo['AnoMes']}) ---")
    print(f"PIX Ticket Médio: R$ {ultimo['PIX_Ticket_Medio_R']:.2f} | Share de Qtd: {ultimo['PIX_Share_Qtd_Pct']:.2f}%")
    print(f"TED Ticket Médio: R$ {ultimo['TED_Ticket_Medio_R']:.2f}")

def executar_modelagem_preditiva(df):
    df_ml = df[df['Era_Post_PIX'] == 1].copy().reset_index(drop=True)
    
    features = ['Indice_Mes', 'quantidadeTED', 'valorTED', 'TED_Ticket_Medio_R', 'PIX_Ticket_Medio_R']
    target = 'valorPix'
    
    X = df_ml[features]
    y = df_ml[target]
    
    X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.20, random_state=42)
    
    scaler = StandardScaler()
    X_train_scaled = scaler.fit_transform(X_train)
    X_test_scaled = scaler.transform(X_test)
    
    modelos = {
        "Regressão Linear": (LinearRegression(), True),
        "Random Forest Regressor": (RandomForestRegressor(n_estimators=100, random_state=42), False),
        "Gradient Boosting Regressor": (GradientBoostingRegressor(n_estimators=100, learning_rate=0.05, random_state=42), False)
    }
    
    resultados = []
    
    for nome, (model, precisa_escalar) in modelos.items():
        if precisa_escalar:
            model.fit(X_train_scaled, y_train)
            y_pred = model.predict(X_test_scaled)
        else:
            model.fit(X_train, y_train)
            y_pred = model.predict(X_test)
            
        mae = mean_absolute_error(y_test, y_pred)
        rmse = np.sqrt(mean_squared_error(y_test, y_pred))
        r2 = r2_score(y_test, y_pred)
        
        resultados.append({
            "Algoritmo": nome,
            "MAE (R$ Mi)": round(mae, 2),
            "RMSE (R$ Mi)": round(rmse, 2),
            "R² Score": round(r2, 4)
        })
        
    return pd.DataFrame(resultados)

if __name__ == "__main__":
    caminho_arquivo = "Meios de Pagamentos Mensais.csv"
    df_processado = carregar_e_tratar_dados(caminho_arquivo)
    df_processado.to_csv("Meios_de_Pagamentos_Mensais_Tratado.csv", index=False, encoding="utf-8-sig")
    
    gerar_estatisticas_resumo(df_processado)
    df_res = executar_modelagem_preditiva(df_processado)
    
    print("\n--- RESULTADOS EXPERIMENTAIS DA MODELAGEM PREDITIVA ---")
    print(df_res.to_string(index=False))
