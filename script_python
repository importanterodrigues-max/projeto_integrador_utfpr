import numpy as np
import pandas as pd
from sklearn.ensemble import GradientBoostingRegressor, RandomForestRegressor
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score
from sklearn.preprocessing import StandardScaler


def carregar_e_tratar_dados(caminho_csv):
  """Carrega a base do BCB, realiza conversões de tipos, ordenação cronológica e

  engenharia de atributos descritivos.
  """
  # 1. Carga do arquivo CSV original do BCB
  df = pd.read_csv(caminho_csv)
  print(
      f'[INFO] Arquivo carregado: {df.shape[0]} linhas e {df.shape[1]} colunas.'
  )

  # 2. Conversão de colunas numéricas (substituição de vírgula decimal por ponto)
  cols_numericas = [c for c in df.columns if c != 'AnoMes']
  for col in cols_numericas:
    df[col] = df[col].astype(str).str.replace(',', '.').astype(float)

  # 3. Tratamento de datas e ordenação cronológica
  df['AnoMes_str'] = df['AnoMes'].astype(str)
  df['Data'] = pd.to_datetime(df['AnoMes_str'], format='%Y%m')
  df = df.sort_values('Data').reset_index(drop=True)
  df['Ano'] = df['Data'].dt.year
  df['Mes'] = df['Data'].dt.month

  # 4. Engenharia de Atributos Descritivos
  # Ticket Médio por transação (R$)
  df['TED_Ticket_Medio_R'] = np.where(
      df['quantidadeTED'] > 0,
      (df['valorTED'] * 1000000) / (df['quantidadeTED'] * 1000),
      0,
  )
  df['PIX_Ticket_Medio_R'] = np.where(
      df['quantidadePix'] > 0,
      (df['valorPix'] * 1000000) / (df['quantidadePix'] * 1000),
      0,
  )

  # Participação do PIX na quantidade total de transações eletrônicas (%)
  df['Total_Qtd_Eletronica'] = (
      df['quantidadeTED']
      + df['quantidadePix']
      + df['quantidadeDOC']
      + df['quantidadeBoleto']
  )
  df['PIX_Share_Qtd_Pct'] = np.where(
      df['Total_Qtd_Eletronica'] > 0,
      (df['quantidadePix'] / df['Total_Qtd_Eletronica']) * 100,
      0,
  )

  # Marcadores temporais
  df['Era_Post_PIX'] = (df['Data'] >= '2020-11-01').astype(int)
  df['Indice_Mes'] = np.arange(1, len(df) + 1)

  return df


def gerar_estatisticas_resumo(df):
  """Exibe no terminal os principais indicadores descritivos das séries analisadas."""
  df_post = df[df['Era_Post_PIX'] == 1]

  print(
